{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursive",
  "version": "0.0.0",
  "identifier": "com.dwarsbit.cursive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cursive",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A Markdown editor for notes",
    "longDescription": "Cursive is a Markdown editor in the style of Notion. Write in a visual mode with no Markdown syntax, switch to Markdown when you want the source, and keep your pages as files on your disk.",
    "copyright": "Copyright (c) 2026 Leon"
  }
}
